# Copie para api/.env (que o git ignora) e ajuste. TODOS os valores abaixo são FICTÍCIOS:
# em qualquer ambiente real, gere segredos novos (ex.: `openssl rand -hex 32`) e
# NUNCA versione o arquivo .env.

# --- Banco (Postgres + PostGIS) ---
DATABASE_URL=postgresql+psycopg://passo:passo-dev@localhost:5432/passo_seguro

# --- Segredos (vazio = recurso desligado; a API fecha por padrão) ---
# Chamadas entre serviços: Authorization: Bearer <SERVICE_TOKEN>
SERVICE_TOKEN=troque-por-um-token-de-servico
# Robô inspetor: cabeçalho X-Device-Token (só vale com a emenda rc2 do contrato)
DEVICE_TOKEN=troque-por-um-token-do-robo
# Raspagem do /metrics (Prometheus): Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=troque-por-um-token-de-metricas
# Sal (chave do HMAC-SHA256) do hash do autor_id. Gere um valor longo e aleatório; trocar o sal
# invalida a ligação entre aparelhos e relatos antigos.
SALT_AUTOR=troque-por-um-sal-longo-e-aleatorio

# --- Serviço de visão (outro serviço; a API só o chama por HTTP) ---
# Sem VISAO_URL e sem fake, a visão fica "fora do ar": o relato é criado com categoria e confiança nulas.
VISAO_URL=
VISAO_TOKEN=
VISAO_TIMEOUT_S=5
# true = usa a visão falsa (a classe sai do hash da imagem, não da foto). Só para desenvolvimento/demonstração.
USE_FAKE_VISAO=true

# --- Assistente (outro serviço) ---
# Sem ASSISTENTE_URL e sem fake, ou se o assistente cair, POST /assistente responde recusou=true
# com a mensagem padrão e o link do SP156 (SP156_URL).
ASSISTENTE_URL=
ASSISTENTE_TOKEN=
ASSISTENTE_TIMEOUT_S=15
USE_FAKE_ASSISTENTE=true
SP156_URL=https://sp156.prefeitura.sp.gov.br/

# --- Painel (arquivo exportado pelo pipeline de dados) ---
# JSON: lista no schema PrioridadeSubprefeitura do contrato. Exemplo: docs/exemplos/vw_prioridades.json
# Sem o arquivo, GET /painel responde 404.
PAINEL_EXPORT_PATH=../docs/exemplos/vw_prioridades.json

# --- Emenda rc2 do contrato (PR feat/contratos-rc2) ---
# false até o grupo aprovar: liga autor_id, X-Device-Token, /relatos/proximos, /meus-relatos e PATCH /relatos/{id}.
# Com true, SALT_AUTOR é obrigatório.
HABILITAR_RC2=false

# --- Logs ---
LOG_LEVEL=INFO

# --- Fotos ---
MEDIA_DIR=./dados/fotos
PUBLIC_BASE_URL=http://localhost:8000

# --- Navegador (CORS): origens do app separadas por vírgula; "*" só em desenvolvimento ---
CORS_ORIGINS=*

# --- Regras ---
# Área onde um relato pode ser criado: lat_min,lon_min,lat_max,lon_max (município de São Paulo).
# Use "sem-limite" para desligar (ex.: testar fora de SP).
AREA_PERMITIDA=-24.01,-46.84,-23.35,-46.36
