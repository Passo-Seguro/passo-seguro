# Copie para observabilidade/.env (que o git ignora) e preencha. Nada aqui é segredo real.

# Endereço público do app (saída "app_url" do Terraform), sem barra no fim.
PUBLIC_URL=https://ca-passoseguro-app.exemplo.azurecontainerapps.io

# Login do Grafana (127.0.0.1:3000).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Webhook do canal do Discord (Configurações do canal > Integrações > Webhooks).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Opcional, só para o ponto de contato por e-mail (comentado no compose e no provisioning).
# SMTP_USER=
# SMTP_PASSWORD=
# ALERTA_EMAIL=
