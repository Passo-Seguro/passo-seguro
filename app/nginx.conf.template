# Modelo do nginx do app. Na partida o entrypoint da imagem oficial roda o envsubst e grava
# o resultado em /etc/nginx/conf.d/default.conf. Só duas variáveis são trocadas (veja
# NGINX_ENVSUBST_FILTER no Dockerfile); tudo o que começa com $ aqui é variável do próprio nginx.
#
#   API_UPSTREAM   endereço interno da API, sem barra no fim (ex.: http://ca-passoseguro-api)
#   METRICS_TOKEN  segredo da raspagem em /metrics/api; VAZIO = sempre 401 (fecha por padrão)
#
# Este arquivo é incluído dentro do bloco "http" do nginx.conf da imagem.

# ---------- Token de métricas ----------
# A chave do segundo "map" é "Bearer <token>" e o padrão do nginx (bucket de 64 bytes) não
# comporta nem um token de 48 caracteres: sem esta linha o "nginx -t" falha com "could not
# build map_hash" e o contêiner nem sobe. 256 deixa folga para rotacionar por um token maior.
map_hash_bucket_size 256;

# Três etapas porque o nginx não tem "E" lógico: (1) o token está configurado?, (2) o
# cabeçalho Authorization é exatamente "Bearer <token>"?, (3) as duas coisas juntas.
# Sem a etapa 1, um token vazio aceitaria o cabeçalho "Bearer " (sem valor).
map "${METRICS_TOKEN}" $metrics_configurado {
    default 1;
    ""      0;
}
map $http_authorization $metrics_cabecalho_ok {
    default                      0;
    "Bearer ${METRICS_TOKEN}"    1;
}
map "$metrics_configurado$metrics_cabecalho_ok" $metrics_liberado {
    default 0;
    "11"    1;
}

# ---------- Cabeçalhos repassados à API ----------
# O TLS termina no ingress, antes do nginx: o esquema real chega em X-Forwarded-Proto.
map $http_x_forwarded_proto $proto_externo {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# ---------- Log sem query string ----------
# As consultas "por perto" levam latitude e longitude: o log guarda só o caminho. Também não
# registra Referer nem cookies. Uma linha JSON por requisição.
map $request_uri $caminho_sem_query {
    default                 $request_uri;
    "~^(?<so_caminho>[^?]*)" $so_caminho;
}
log_format json_sem_query escape=json
    '{"ts":"$time_iso8601","metodo":"$request_method","caminho":"$caminho_sem_query",'
    '"status":$status,"bytes":$body_bytes_sent,"ms":$request_time,'
    '"upstream_ms":"$upstream_response_time","ip":"$remote_addr"}';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    access_log /var/log/nginx/access.log json_sem_query;
    # O log de ERRO do nginx imprime a linha de requisição inteira, com a query string, e isso
    # não dá para filtrar. Por isso só registra falhas graves; 502/504 aparecem no access log.
    error_log /var/log/nginx/error.log crit;

    # A imagem não conhece .webmanifest: sem isto sairia como application/octet-stream.
    # (um bloco "types" no server substitui o do http; por isso o include antes.)
    include /etc/nginx/mime.types;
    types {
        application/manifest+json webmanifest;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------- API (proxy) ----------
    # /api/metrics NUNCA sai para a internet: a raspagem passa por /metrics/api, com token.
    # (nginx normaliza "//", "/./" e %XX antes de escolher o location, então as variações
    # também caem aqui.)
    location ^~ /api/metrics {
        return 404;
    }

    # "^~" é necessário: sem ele a regra de ícones (.png/.ico/.svg) mais abaixo ganharia de
    # /api/fotos/x.png. A barra final em proxy_pass troca o prefixo /api/ por /.
    location ^~ /api/ {
        include /etc/nginx/seguranca.inc;

        # Teto da foto: a API aceita MAX_UPLOAD_BYTES (10 MiB). Aqui fica um pouco acima para
        # a própria API recusar com o erro em JSON do contrato (413) em vez de a página do nginx.
        client_max_body_size 11m;

        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Sem "proxy_set_header Host $host" de propósito: o ingress interno do Azure Container
        # Apps escolhe o destino pelo Host. Com o nome público do app a chamada voltaria para
        # o próprio app. O padrão do nginx envia o nome do upstream (ex.: ca-passoseguro-api);
        # o nome público segue em X-Forwarded-Host.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proto_externo;
        proxy_set_header X-Forwarded-Host $host;

        # O primeiro acesso depois de escala zero espera a API subir (e migrar o banco).
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
        # POST não pode ser repetido em outro servidor sem o usuário saber.
        proxy_next_upstream off;
    }

    # ---------- Métricas (raspagem) ----------
    # Só com "Authorization: Bearer <METRICS_TOKEN>". O mesmo cabeçalho segue para a API, que
    # também confere o token (defesa em duas camadas). Token vazio = sempre 401.
    location = /metrics/api {
        if ($metrics_liberado = 0) {
            add_header WWW-Authenticate "Bearer" always;
            add_header Cache-Control "no-store" always;
            return 401;
        }

        limit_except GET HEAD {
            deny all;
        }

        include /etc/nginx/seguranca.inc;
        add_header Cache-Control "no-store" always;

        proxy_pass ${API_UPSTREAM}/metrics;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proto_externo;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_next_upstream off;
    }

    # ---------- PWA ----------
    # Arquivos com hash no nome: cache longo.
    location /assets/ {
        include /etc/nginx/seguranca.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Service worker e manifesto: sempre revalidar, para o app atualizar.
    location ~* ^/(sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        include /etc/nginx/seguranca.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Ícones (sem hash no nome): cache de um dia.
    location ~* \.(png|ico|svg)$ {
        include /etc/nginx/seguranca.inc;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # Qualquer rota do app cai no index.html (o roteador roda no navegador).
    location / {
        include /etc/nginx/seguranca.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
